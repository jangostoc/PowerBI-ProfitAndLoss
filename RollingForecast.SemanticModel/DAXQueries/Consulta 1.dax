SUMMARIZECOLUMNS (
    dEscenario[Escenario],
    TREATAS ( { 2026 }, dCalendario[Año] ),
    "EBITDA Cierre", [EBITDA Cierre],
    "EBITDA Ppto",   [EBITDA Ppto],
    "Gap",           [Gap EBITDA vs Ppto]
)
EVALUATE
SUMMARIZECOLUMNS (
    dCalendario[Año],
    "Ppto", [Ppto],
    "Real", [Real]
)